# ----------------------------------------------------------------------------
# Application
# ----------------------------------------------------------------------------
NODE_ENV=development
PORT=3000
# Global route prefix for the HTTP API.
API_PREFIX=api

# ----------------------------------------------------------------------------
# Database (PostgreSQL)
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public
# ----------------------------------------------------------------------------
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/mini_erp?schema=public

# ----------------------------------------------------------------------------
# Authentication (JWT)
# Use long, random secrets in every non-local environment.
# ----------------------------------------------------------------------------
JWT_ACCESS_SECRET=change-me-access-secret
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=change-me-refresh-secret
JWT_REFRESH_EXPIRES_IN=7d

# ----------------------------------------------------------------------------
# Database seeding (optional)
# ----------------------------------------------------------------------------
SEED_ADMIN_EMAIL=admin@mini-erp.local
SEED_ADMIN_PASSWORD=ChangeMe123!
